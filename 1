class AdaptiveQuantEngine:

    def __init__(self, config=None):

        self.cfg = config or AQConfig()

        self.memory = {}

    # ---------------------------------------------------------

    def _get_symbol(self, symbol):

        if symbol not in self.memory:

            self.memory[symbol] = SymbolMemory()

        return self.memory[symbol]

    # ---------------------------------------------------------

    def learn(

        self,

        symbol,

        logs,

        timeframe="1H"

    ):

        rates, threshold, binary, windows = WindowBuilder.build(

            logs,

            self.cfg

        )

        mem = self._get_symbol(symbol)

        if timeframe == "1H":

            mem.hourly["DEFAULT"] = windows

        else:

            mem.minute10["DEFAULT"] = windows

        Util.debug(

            self.cfg,

            f"{symbol} Learn Complete",

            f"Windows={len(windows)}"

        )

        return windows

    # ---------------------------------------------------------

    def predict(

        self,

        symbol,

        timeframe="1H"

    ):

        if symbol not in self.memory:

            return []

        mem = self.memory[symbol]

        if timeframe == "1H":

            return mem.hourly.get(

                "DEFAULT",

                []

            )

        return mem.minute10.get(

            "DEFAULT",

            []

        )

    # ---------------------------------------------------------

    def top(

        self,

        symbol,

        timeframe="1H",

        n=None

    ):

        n = n or self.cfg.max_windows

        windows = self.predict(

            symbol,

            timeframe

        )

        windows.sort(

            key=lambda w:

                (

                    w.weighted_mean,

                    w.consistency,

                    w.trade_count,

                    w.length_bonus

                ),

            reverse=True

        )

        return windows[:n]

    # ---------------------------------------------------------

    def debug(

        self,

        symbol,

        timeframe="1H",

        slots=24

    ):

        windows = self.predict(

            symbol,

            timeframe

        )

        WindowFormatter.print(

            windows,

            slots

        )

    # ---------------------------------------------------------

    def clear(self):

        self.memory.clear()

    # ---------------------------------------------------------

    def symbols(self):

        return list(

            self.memory.keys()

        )
