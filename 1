# ============================================================
# TIME DECAY
# ============================================================

class TimeDecay:

    @staticmethod
    def weights(n: int, alpha: float):

        if n <= 0:
            return np.array([])

        w = alpha ** np.arange(n - 1, -1, -1)

        return w / w.sum()

    @staticmethod
    def mean(values, alpha):

        values = np.asarray(values, dtype=float)

        if len(values) == 0:
            return 0.0

        w = TimeDecay.weights(len(values), alpha)

        return float(np.average(values, weights=w))

    @staticmethod
    def std(values, alpha):

        values = np.asarray(values, dtype=float)

        if len(values) == 0:
            return 0.0

        w = TimeDecay.weights(len(values), alpha)

        m = np.average(values, weights=w)

        var = np.average((values - m) ** 2, weights=w)

        return float(np.sqrt(var))


# ============================================================
# STATISTICS
# ============================================================

class Statistics:

    @staticmethod
    def weighted_mean(values, alpha):

        return TimeDecay.mean(values, alpha)

    @staticmethod
    def weighted_std(values, alpha):

        return TimeDecay.std(values, alpha)

    @staticmethod
    def stability(std):

        return 1.0 / (1.0 + std)

    @staticmethod
    def length_bonus(length):

        return np.clip(

            np.log2(length + 1),

            1.0,

            4.0

        )

    @staticmethod
    def trade_bonus(trades):

        return np.clip(

            np.log2(trades + 2),

            1.0,

            6.0

        )

    @staticmethod
    def confidence(trades, minimum):

        return min(

            1.0,

            trades / max(1, minimum)

        )

    @staticmethod
    def win_rate(values):

        values = np.asarray(values)

        if len(values) == 0:
            return 0.0

        return float(np.mean(values > 0))

    @staticmethod
    def winrate_bonus(winrate):

        return np.clip(

            0.5 + winrate,

            0.8,

            1.5

        )

    @staticmethod
    def profit_factor(values):

        values = np.asarray(values)

        gp = values[values > 0].sum()

        gl = abs(values[values < 0].sum())

        return gp / (gl + EPS)

    @staticmethod
    def profit_factor_bonus(pf):

        return np.clip(

            np.log2(pf + 1),

            0.8,

            2.5

        )


# ============================================================
# UTIL
# ============================================================

class Util:

    @staticmethod
    def slot_to_hour(slot):

        return f"{slot:02d}:00"

    @staticmethod
    def slot_to_10m(slot):

        h = slot // 6

        m = (slot % 6) * 10

        return f"{h:02d}:{m:02d}"

    @staticmethod
    def slot_label(slot, total_slots):

        if total_slots == 24:

            return Util.slot_to_hour(slot)

        if total_slots == 144:

            return Util.slot_to_10m(slot)

        return str(slot)

    @staticmethod
    def flatten(logs):

        out = []

        for x in logs:

            out.extend(x)

        return out

    @staticmethod
    def debug(cfg: AQConfig, *args):

        if cfg.debug:

            print("[AQGW]", *args)


