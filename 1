class QuantScore:

    @staticmethod
    def quality(window):

        return (

            max(window.weighted_mean, 0.0)

            ** 1.5

            *

            window.consistency

        )

    # ---------------------------------------------------------

    @staticmethod
    def statistical(window):

        return (

            window.stability

            *

            window.length_bonus

        )

    # ---------------------------------------------------------

    @staticmethod
    def reliability(window):

        return (

            window.trade_bonus

            *

            window.confidence

        )

    # ---------------------------------------------------------

    @staticmethod
    def score(window):

        quality = QuantScore.quality(window)

        statistical = QuantScore.statistical(window)

        reliability = QuantScore.reliability(window)

        score = (

            quality

            *

            statistical

            *

            reliability

        )

        return float(np.clip(score, 0.0, 100.0))


# ============================================================
#
# SCORE ENGINE
#
# ============================================================

class ScoreEngine:

    @staticmethod
    def update(windows):

        for w in windows:

            w.score = QuantScore.score(w)

        return windows


# ============================================================
#
# RANKING
#
# ============================================================

class Ranking:

    @staticmethod
    def sort(windows):

        windows.sort(

            key=lambda w: (

                w.score,

                w.weighted_mean,

                w.consistency,

                w.trade_count,

                w.length_bonus,

                -w.weighted_std

            ),

            reverse=True

        )

        return windows


# ============================================================
#
# ENGINE PATCH
#
# ============================================================

def _engine_score(self, windows):

    windows = ScoreEngine.update(windows)

    windows = Ranking.sort(windows)

    return windows


AdaptiveQuantEngine.score = _engine_score


