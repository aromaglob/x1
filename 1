import re


# ============================================================
# PREPROCESS
# ============================================================

class Preprocessor:

    @staticmethod
    def build_rates(logs, cfg):

        rates = []

        for slot_logs in logs:

            if len(slot_logs):

                rate = Statistics.weighted_mean(
                    slot_logs,
                    cfg.decay_alpha
                )

            else:

                rate = cfg.default_rate

            rates.append(rate)

        return np.asarray(rates, dtype=float)

    @staticmethod
    def threshold(rates, cfg):

        return np.percentile(
            rates,
            cfg.percentile
        )

    @staticmethod
    def binary(rates, threshold):

        return (rates >= threshold).astype(np.int8)


# ============================================================
# REGEX WINDOW
# ============================================================

class RegexWindow:

    @staticmethod
    def extract(binary):

        text = "".join(map(str, binary))

        windows = []

        for m in re.finditer("1+", text):

            windows.append(

                (

                    m.start(),

                    m.end() - 1

                )

            )

        return windows


# ============================================================
# FEATURE
# ============================================================

class FeatureExtractor:

    @staticmethod
    def build_window(

        logs,

        rates,

        start,

        end,

        cfg

    ):

        values = []

        trade_count = 0

        for i in range(start, end + 1):

            values.extend(logs[i])

            trade_count += len(logs[i])

        if len(values) == 0:

            return None

        values = np.asarray(values)

        wmean = Statistics.weighted_mean(
            values,
            cfg.decay_alpha
        )

        wstd = Statistics.weighted_std(
            values,
            cfg.decay_alpha
        )

        stability = Statistics.stability(
            wstd
        )

        length = end - start + 1

        length_bonus = Statistics.length_bonus(
            length
        )

        trade_bonus = Statistics.trade_bonus(
            trade_count
        )

        confidence = Statistics.confidence(

            trade_count,

            cfg.min_trades

        )

        winrate = Statistics.win_rate(
            values
        )

        win_bonus = Statistics.winrate_bonus(
            winrate
        )

        pf = Statistics.profit_factor(
            values
        )

        pf_bonus = Statistics.profit_factor_bonus(
            pf
        )

        consistency = (
            win_bonus
            *
            pf_bonus
        )

        return Window(

            start=start,

            end=end,

            weighted_mean=wmean,

            weighted_std=wstd,

            stability=stability,

            length_bonus=length_bonus,

            trade_bonus=trade_bonus,

            confidence=confidence,

            win_rate=winrate,

            profit_factor=pf,

            consistency=consistency,

            trade_count=trade_count

        )


# ============================================================
# WINDOW BUILDER
# ============================================================

class WindowBuilder:

    @staticmethod
    def build(

        logs,

        cfg

    ):

        rates = Preprocessor.build_rates(

            logs,

            cfg

        )

        threshold = Preprocessor.threshold(

            rates,

            cfg

        )

        binary = Preprocessor.binary(

            rates,

            threshold

        )

        spans = RegexWindow.extract(

            binary

        )

        windows = []

        for start, end in spans:

            w = FeatureExtractor.build_window(

                logs,

                rates,

                start,

                end,

                cfg

            )

            if w is not None:

                windows.append(w)

        return (

            rates,

            threshold,

            binary,

            windows

        )


