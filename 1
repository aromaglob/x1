from enum import Enum


# ============================================================
# REGIME
# ============================================================

class MarketRegime(str, Enum):

    UP = "UP"

    DOWN = "DOWN"

    SIDE = "SIDE"

    HIGH_VOL = "HIGH_VOL"

    LOW_VOL = "LOW_VOL"


# ============================================================
# REGIME DETECTOR
# ============================================================

class RegimeDetector:

    @staticmethod
    def detect(
        prices,
        trend_threshold=0.03,
        vol_threshold=0.02
    ):

        prices = np.asarray(prices, dtype=float)

        if len(prices) < 5:
            return MarketRegime.SIDE

        ret = np.diff(prices) / (prices[:-1] + EPS)

        trend = (prices[-1] - prices[0]) / (prices[0] + EPS)

        vol = np.std(ret)

        if vol >= vol_threshold:
            return MarketRegime.HIGH_VOL

        if trend >= trend_threshold:
            return MarketRegime.UP

        if trend <= -trend_threshold:
            return MarketRegime.DOWN

        return MarketRegime.SIDE


# ============================================================
# REGIME MEMORY
# ============================================================

class RegimeMemory:

    def __init__(self):

        self.data = {}

    def put(

        self,

        symbol,

        regime,

        windows

    ):

        self.data.setdefault(symbol, {})

        self.data[symbol][regime] = windows

    def get(

        self,

        symbol,

        regime

    ):

        return self.data.get(

            symbol,

            {}

        ).get(

            regime,

            []

        )

    def regimes(self, symbol):

        return list(

            self.data.get(

                symbol,

                {}

            ).keys()

        )


# ============================================================
# REGIME WEIGHT
# ============================================================

class RegimeWeight:

    DEFAULT = {

        MarketRegime.UP: 1.05,

        MarketRegime.DOWN: 0.95,

        MarketRegime.SIDE: 1.00,

        MarketRegime.HIGH_VOL: 0.95,

        MarketRegime.LOW_VOL: 1.02,

    }

    @classmethod
    def weight(

        cls,

        regime

    ):

        return cls.DEFAULT.get(

            regime,

            1.0

        )


# ============================================================
# SCORE PATCH
# ============================================================

_old_score = QuantScore.score


def _score(window):

    base = _old_score(window)

    regime_weight = RegimeWeight.weight(

        MarketRegime(window.regime)

        if isinstance(window.regime, str)

        else window.regime

    )

    return float(

        np.clip(

            base * regime_weight,

            0,

            100

        )

    )


QuantScore.score = staticmethod(_score)


# ============================================================
# ENGINE PATCH
# ============================================================

AdaptiveQuantEngine.regime_memory = RegimeMemory()


def learn_regime(

    self,

    symbol,

    logs,

    prices,

    timeframe="1H"

):

    regime = RegimeDetector.detect(

        prices

    )

    windows = self.learn(

        symbol,

        logs,

        timeframe

    )

    for w in windows:

        w.regime = regime

        w.score = QuantScore.score(w)

    self.regime_memory.put(

        symbol,

        regime,

        windows

    )

    Util.debug(

        self.cfg,

        f"{symbol}",

        f"Regime={regime}",

        f"Windows={len(windows)}"

    )

    return windows


AdaptiveQuantEngine.learn_regime = learn_regime


# ============================================================
# PREDICT REGIME
# ============================================================

def predict_regime(

    self,

    symbol,

    prices

):

    regime = RegimeDetector.detect(

        prices

    )

    windows = self.regime_memory.get(

        symbol,

        regime

    )

    windows = Ranking.sort(

        windows

    )

    return windows


AdaptiveQuantEngine.predict_regime = predict_regime


