import numpy as np
import re


class GoldenWindowFinder:

    def __init__(
        self,
        percentile=65,
        default_rate=0.5
    ):
        self.percentile = percentile
        self.default_rate = default_rate

    # -----------------------------------------------------
    # Slot -> Time
    # -----------------------------------------------------
    @staticmethod
    def slot_to_time(slot, slot_minutes):

        total = slot * slot_minutes

        h = total // 60
        m = total % 60

        return f"{h:02d}:{m:02d}"

    # -----------------------------------------------------
    # Main
    # -----------------------------------------------------
    def find(
        self,
        logs,
        slot_minutes=60,
        max_windows=4
    ):

        slot_count = len(logs)

        # =====================================
        # STEP 1
        # Average
        # =====================================

        rates = [

            np.mean(x)
            if len(x)
            else self.default_rate

            for x in logs

        ]

        # =====================================
        # STEP 2
        # Percentile
        # =====================================

        threshold = np.percentile(
            rates,
            self.percentile
        )

        # =====================================
        # STEP 3
        # Binary
        # =====================================

        binary = "".join(

            "1"
            if r >= threshold
            else "0"

            for r in rates

        )

        # =====================================
        # STEP 4
        # Regex
        # =====================================

        windows = []

        for match in re.finditer(r"1+", binary):

            start = match.start()

            end = match.end() - 1

            score = float(
                np.mean(
                    rates[start:end+1]
                )
            )

            length = end - start + 1

            windows.append({

                "start": start,

                "end": end,

                "length": length,

                "score": score,

                "start_time":
                    self.slot_to_time(
                        start,
                        slot_minutes
                    ),

                "end_time":
                    self.slot_to_time(
                        end,
                        slot_minutes
                    ),

                "binary":
                    binary[start:end+1]

            })

        # =====================================
        # STEP 5
        # Sort
        # =====================================

        windows.sort(

            key=lambda w: (

                w["score"],

                w["length"]

            ),

            reverse=True

        )

        windows = windows[:max_windows]

        return {

            "threshold": threshold,

            "rates": rates,

            "binary": binary,

            "windows": windows

        }


