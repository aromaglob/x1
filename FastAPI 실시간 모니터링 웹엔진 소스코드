import numpy as np
import time
from threading import Thread
from datetime import datetime
from abc import ABC, abstractmethod
from typing import List, Dict, Any, Set
from dataclasses import dataclass, asdict
from fastapi import FastAPI, Query
from pydantic import BaseModel

@dataclass(frozen=True)
class TradingSlotSignal:
    slot_index: int
    macro_hour: int
    score: float
    start_time: str
    end_time: str

class MultiTimeframeRepository(ABC):
    @abstractmethod
    def get_hour_logs(self, symbol: str) -> List[List[int]]:
        pass 

    @abstractmethod
    def get_ten_minute_logs(self, symbol: str) -> List[List[int]]:
        pass

class AdvancedSlotSelector:
    def __init__(self, repository: MultiTimeframeRepository) -> None:
        if repository is None:
            raise ValueError("CRITICAL_ERR: Repository interface binding cannot be null.")
        self.repository = repository 

    def select_elite_trading_slots(
        self,
        symbol: str,
        hour_percentile: float = 50.0,
        max_final_slots: int = 24
    ) -> List[TradingSlotSignal]:
        if not symbol or not isinstance(symbol, str):
            raise ValueError("INVALID_PARAMETER: Symbol string is null or empty.")
        if not (0.0 <= hour_percentile <= 100.0):
            raise ValueError("INVALID_PARAMETER: Hour percentile must be between 0.0 and 100.0.")
        if max_final_slots <= 0:
            raise ValueError("INVALID_PARAMETER: Maximum final slots must be greater than zero.") 

        try:
            hour_logs: List[List[int]] = self.repository.get_hour_logs(symbol)
            ten_min_logs: List[List[int]] = self.repository.get_ten_minute_logs(symbol)
        except Exception as exc:
            raise RuntimeError(f"HARDWARE_IO_ERR: Failed to pull dataset via interface pipeline: {str(exc)}") from exc 

        if len(hour_logs) != 24:
            raise ValueError(f"DATA_INTEGRITY_ERR: Expected exactly 24 hourly logs, got {len(hour_logs)}.")
        if len(ten_min_logs) != 144:
            raise ValueError(f"DATA_INTEGRITY_ERR: Expected exactly 144 ten-minute logs, got {len(ten_min_logs)}.") 

        hour_rates: List[float] = []
        for idx, h_log in enumerate(hour_logs):
            if not isinstance(h_log, list):
                raise TypeError(f"TYPE_VIOLATION: Element at hour index {idx} is not a valid list structures.") 

            log_len: int = len(h_log)
            if log_len > 0: 
                if not all(isinstance(val, int) and (val == 0 or val == 1) for val in h_log):
                    raise ValueError(f"DATA_VIOLATION: Non-binary payload detected at hour index {idx}.")
                hour_rates.append(float(np.mean(h_log)))
            else:
                hour_rates.append(0.5) 

        try:
            hour_threshold: float = float(np.percentile(hour_rates, hour_percentile))
        except Exception:
            hour_threshold = 0.5 

        qualified_hours: Set[int] = {
            h_idx for h_idx, rate in enumerate(hour_rates) if rate >= hour_threshold
        } 

        all_candidate_slots: List[TradingSlotSignal] = [] 

        for i in range(144):
            belonging_hour: int = i // 6 

            if belonging_hour in qualified_hours:
                t_log: List[int] = ten_min_logs[i]
                if not isinstance(t_log, list):
                    raise TypeError(f"TYPE_VIOLATION: Element at slot index {i} is not a valid list structures.")
                t_len: int = len(t_log)
                if t_len > 0:
                    if not all(isinstance(val, int) and (val == 0 or val == 1) for val in t_log):
                        raise ValueError(f"DATA_VIOLATION: Non-binary payload detected at slot index {i}.")
                    score: float = float(np.mean(t_log))
                else:
                    score = 0.5

                total_start_mins: int = i * 10
                total_end_mins: int = (i + 1) * 10

                start_time: str = f"{(total_start_mins // 60) % 24:02d}:{total_start_mins % 60:02d}"
                end_time: str = f"{(total_end_mins // 60) % 24:02d}:{total_end_mins % 60:02d}"

                all_candidate_slots.append(
                    TradingSlotSignal(
                        slot_index=i,
                        macro_hour=belonging_hour,
                        score=score,
                        start_time=start_time,
                        end_time=end_time
                    )
                ) 

        all_candidate_slots.sort(key=lambda s: (s.score, -s.slot_index), reverse=True)
        final_selected_slots: List[TradingSlotSignal] = all_candidate_slots[:max_final_slots]
        final_selected_slots.sort(key=lambda s: s.slot_index)
        return final_selected_slots

class SimulatedMarketRepository(MultiTimeframeRepository):
    def get_hour_logs(self, symbol: str) -> List[List[int]]:
        np.random.seed(42)
        return [np.random.choice([0, 1], size=np.random.randint(10, 30), p=[0.48, 0.52]).tolist() for _ in range(24)] 

    def get_ten_minute_logs(self, symbol: str) -> List[List[int]]:
        np.random.seed(999)
        mock_data = [np.random.choice([0, 1], size=np.random.randint(3, 10), p=[0.46, 0.54]).tolist() for _ in range(144)]
        now = datetime.now()
        current_slot = ((now.hour * 60) + now.minute) // 10
        mock_data[current_slot] = [1, 1, 1, 1, 1]
        return mock_data

app = FastAPI(title="Mission-Critical Trading Engine Server", version="3.0.0")

ENGINE_STATE = {
    "symbol": "BTCUSDT",
    "hour_percentile": 50.0,
    "max_final_slots": 24,
    "cached_slots_list": [],
    "cached_slots_dict": {},
    "last_triggered_slot": -1,
    "is_running": True,
    "execution_logs": []
}

class SystemStatusResponse(BaseModel):
    symbol: str
    engine_active: bool
    last_triggered_slot: int
    current_slot_index: int
    total_target_slots: int

def execute_live_order(signal_info: TradingSlotSignal):
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    log_msg = f"[ORDER EXECUTION] {timestamp} | Slot: {signal_info.slot_index:03d} ({signal_info.start_time}~{signal_info.end_time}) | Score: {signal_info.score:.3f}"
    print(f"\n🚀 {log_msg}")
    ENGINE_STATE["execution_logs"].append(log_msg)
    if len(ENGINE_STATE["execution_logs"]) > 100:
        ENGINE_STATE["execution_logs"].pop(0)

def background_monitoring_loop():
    while ENGINE_STATE["is_running"]:
        try:
            now = datetime.now()
            current_slot_index = ((now.hour * 60) + now.minute) // 10
            target_map = ENGINE_STATE["cached_slots_dict"]
            
            if current_slot_index in target_map:
                if current_slot_index != ENGINE_STATE["last_triggered_slot"]:
                    signal_data = target_map[current_slot_index]
                    execute_live_order(signal_data)
                    ENGINE_STATE["last_triggered_slot"] = current_slot_index
            
            time.sleep(1)
        except Exception as err:
            print(f"🚨 ENGINE_LOOP_ERROR: {str(err)}")
            time.sleep(5)

@app.on_event("startup")
def boot_trading_system():
    repository = SimulatedMarketRepository()
    selector = AdvancedSlotSelector(repository=repository)
    
    elite_slots = selector.select_elite_trading_slots(
        symbol=ENGINE_STATE["symbol"],
        hour_percentile=ENGINE_STATE["hour_percentile"],
        max_final_slots=ENGINE_STATE["max_final_slots"]
    )
    
    ENGINE_STATE["cached_slots_list"] = elite_slots
    ENGINE_STATE["cached_slots_dict"] = {s.slot_index: s for s in elite_slots}
    
    loop_thread = Thread(target=background_monitoring_loop, daemon=True)
    loop_thread.start()

@app.on_event("shutdown")
def shutdown_trading_system():
    ENGINE_STATE["is_running"] = False

@app.get("/api/v3/engine/status", response_model=SystemStatusResponse)
def get_engine_status():
    now = datetime.now()
    current_slot = ((now.hour * 60) + now.minute) // 10
    return {
        "symbol": ENGINE_STATE["symbol"],
        "engine_active": ENGINE_STATE["is_running"],
        "last_triggered_slot": ENGINE_STATE["last_triggered_slot"],
        "current_slot_index": current_slot,
        "total_target_slots": len(ENGINE_STATE["cached_slots_list"])
    }

@app.get("/api/v3/engine/slots")
def get_calibrated_slots():
    return [asdict(s) for s in ENGINE_STATE["cached_slots_list"]]

@app.get("/api/v3/engine/logs")
def get_order_logs():
    return {"order_history": ENGINE_STATE["execution_logs"][::-1]}

@app.post("/api/v3/engine/recalibrate")
def trigger_recalibration(percentile: float = Query(50.0), max_slots: int = Query(24)):
    repository = SimulatedMarketRepository()
    selector = AdvancedSlotSelector(repository=repository)
    
    ENGINE_STATE["hour_percentile"] = percentile
    ENGINE_STATE["max_final_slots"] = max_slots
    
    elite_slots = selector.select_elite_trading_slots(
        symbol=ENGINE_STATE["symbol"],
        hour_percentile=percentile,
        max_final_slots=max_slots
    )
    
    ENGINE_STATE["cached_slots_list"] = elite_slots
    ENGINE_STATE["cached_slots_dict"] = {s.slot_index: s for s in elite_slots}
    return {"status": "SUCCESS", "message": f"Engine recalibrated with percentile {percentile} and max_slots {max_slots}."}
